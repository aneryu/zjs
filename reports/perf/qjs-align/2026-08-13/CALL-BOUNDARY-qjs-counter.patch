                                int atom_type);
@@ -6028,8 +6120,15 @@ static JSValue js_c_function_data_call(JSContext *ctx, JSValueConst func_obj,
 {
     JSCFunctionDataRecord *s = JS_GetOpaque(func_obj, JS_CLASS_C_FUNCTION_DATA);
     JSValueConst *arg_buf;
+    JSValue ret;
     int i;
 
+    if (call_boundary_enabled) {
+        call_boundary_native_calls++;
+        call_boundary_c_function_data_calls++;
+        call_boundary_native_depth++;
+    }
+
     /* XXX: could add the function on the stack for debug */
     if (unlikely(argc < s->length)) {
         arg_buf = alloca(sizeof(arg_buf[0]) * s->length);
@@ -6041,7 +6140,10 @@ static JSValue js_c_function_data_call(JSContext *ctx, JSValueConst func_obj,
         arg_buf = argv;
     }
 
-    return s->func(ctx, this_val, argc, arg_buf, s->magic, s->data);
+    ret = s->func(ctx, this_val, argc, arg_buf, s->magic, s->data);
+    if (call_boundary_enabled)
+        call_boundary_native_depth--;
+    return ret;
 }
 
 JSValue JS_NewCFunctionData(JSContext *ctx, JSCFunctionData *func,
@@ -7876,6 +7978,8 @@ static no_inline __exception int __js_poll_interrupts(JSContext *ctx)
 
 static inline __exception int js_poll_interrupts(JSContext *ctx)
 {
+    if (call_boundary_enabled)
+        call_boundary_interrupt_polls++;
     if (unlikely(--ctx->interrupt_counter <= 0)) {
         return __js_poll_interrupts(ctx);
     } else {
@@ -17572,6 +17676,14 @@ static JSValue js_call_c_function(JSContext *ctx, JSValueConst func_obj,
     int arg_count, i;
     JSCFunctionEnum cproto;
 
+    if (call_boundary_enabled) {
+        call_boundary_native_calls++;
+        call_boundary_c_function_calls++;
+        call_boundary_native_depth++;
+        call_boundary_frame_publishes++;
+        call_boundary_backtrace_publishes++;
+    }
+
     p = JS_VALUE_GET_OBJ(func_obj);
     cproto = p->u.cfunc.cproto;
     arg_count = p->u.cfunc.length;
@@ -17685,6 +17797,11 @@ static JSValue js_call_c_function(JSContext *ctx, JSValueConst func_obj,
     }
 
     rt->current_stack_frame = sf->prev_frame;
+    if (call_boundary_enabled) {
+        call_boundary_native_depth--;
+        call_boundary_frame_restores++;
+        call_boundary_backtrace_restores++;
+    }
     return ret_val;
 }
 
@@ -17758,6 +17875,8 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
     JSVarRef **var_refs;
     size_t alloca_size;
 
+    call_boundary_enabled = 1;
+
 #if !DIRECT_DISPATCH
 #define SWITCH(pc)      switch (opcode = *pc++)
 #define CASE(op)        case op
@@ -17802,6 +17921,7 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
             sp = sf->cur_sp;
             sf->cur_sp = NULL; /* cur_sp is NULL if the function is running */
             pc = sf->cur_pc;
+            call_boundary_record_bytecode_entry(rt, 0);
             sf->prev_frame = rt->current_stack_frame;
             rt->current_stack_frame = sf;
             if (s->throw_flag)
@@ -17866,6 +17986,7 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
         sf->var_refs[i] = NULL;
     sp = stack_buf;
     pc = b->byte_code_buf;
+    call_boundary_record_bytecode_entry(rt, alloca_size);
     sf->prev_frame = rt->current_stack_frame;
     rt->current_stack_frame = sf;
     ctx = b->realm; /* set the current realm */
@@ -20707,6 +20828,8 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
         }
     }
     rt->current_stack_frame = sf->prev_frame;
+    call_boundary_bytecode_returns++;
+    call_boundary_frame_restores++;
     return ret_val;
 }
 

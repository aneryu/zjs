--- a/quickjs.c
+++ b/quickjs.c
@@ -1143,6 +1143,98 @@ enum OPCodeEnum {
     OP_TEMP_END,
 };
 
+/* CALL-BOUNDARY-DIAGNOSIS counter-only instrumentation. Never time this build. */
+static int call_boundary_enabled;
+static int call_boundary_native_depth;
+static uint64_t call_boundary_bytecode_entries;
+static uint64_t call_boundary_bytecode_returns;
+static uint64_t call_boundary_js_to_js;
+static uint64_t call_boundary_root_entries;
+static uint64_t call_boundary_native_reentries;
+static uint64_t call_boundary_native_calls;
+static uint64_t call_boundary_c_function_calls;
+static uint64_t call_boundary_c_function_data_calls;
+static uint64_t call_boundary_frame_publishes;
+static uint64_t call_boundary_frame_restores;
+static uint64_t call_boundary_backtrace_publishes;
+static uint64_t call_boundary_backtrace_restores;
+static uint64_t call_boundary_frame_alloca_count;
+static uint64_t call_boundary_frame_alloca_bytes;
+static uint64_t call_boundary_interrupt_polls;
+
+static void call_boundary_record_bytecode_entry(JSRuntime *rt, size_t alloca_size)
+{
+    JSStackFrame *previous = rt->current_stack_frame;
+    call_boundary_bytecode_entries++;
+    call_boundary_frame_publishes++;
+    if (alloca_size) {
+        call_boundary_frame_alloca_count++;
+        call_boundary_frame_alloca_bytes += alloca_size;
+    }
+    if (previous && JS_VALUE_GET_TAG(previous->cur_func) == JS_TAG_OBJECT) {
+        int class_id = JS_VALUE_GET_OBJ(previous->cur_func)->class_id;
+        if (class_id == JS_CLASS_BYTECODE_FUNCTION) {
+            call_boundary_js_to_js++;
+        } else if (class_id == JS_CLASS_C_FUNCTION) {
+            call_boundary_native_reentries++;
+        } else if (call_boundary_native_depth > 0) {
+            call_boundary_native_reentries++;
+        } else {
+            call_boundary_root_entries++;
+        }
+    } else if (call_boundary_native_depth > 0) {
+        call_boundary_native_reentries++;
+    } else {
+        call_boundary_root_entries++;
+    }
+}
+
+static void call_boundary_dump_at_exit(void) __attribute__((destructor));
+static void call_boundary_dump_at_exit(void)
+{
+    const char *path = getenv("CALL_BOUNDARY_QJS_COUNTERS");
+    FILE *out;
+    if (!path || !path[0])
+        return;
+    out = fopen(path, "w");
+    if (!out)
+        return;
+    fprintf(out,
+            "{\n"
+            "  \"bytecode_entries\": %" PRIu64 ",\n"
+            "  \"bytecode_returns\": %" PRIu64 ",\n"
+            "  \"js_to_js\": %" PRIu64 ",\n"
+            "  \"root_entries\": %" PRIu64 ",\n"
+            "  \"native_reentries\": %" PRIu64 ",\n"
+            "  \"native_calls\": %" PRIu64 ",\n"
+            "  \"c_function_calls\": %" PRIu64 ",\n"
+            "  \"c_function_data_calls\": %" PRIu64 ",\n"
+            "  \"frame_publishes\": %" PRIu64 ",\n"
+            "  \"frame_restores\": %" PRIu64 ",\n"
+            "  \"backtrace_publishes\": %" PRIu64 ",\n"
+            "  \"backtrace_restores\": %" PRIu64 ",\n"
+            "  \"frame_alloca_count\": %" PRIu64 ",\n"
+            "  \"frame_alloca_bytes\": %" PRIu64 ",\n"
+            "  \"interrupt_polls\": %" PRIu64 "\n"
+            "}\n",
+            call_boundary_bytecode_entries,
+            call_boundary_bytecode_returns,
+            call_boundary_js_to_js,
+            call_boundary_root_entries,
+            call_boundary_native_reentries,
+            call_boundary_native_calls,
+            call_boundary_c_function_calls,
+            call_boundary_c_function_data_calls,
+            call_boundary_frame_publishes,
+            call_boundary_frame_restores,
+            call_boundary_backtrace_publishes,
+            call_boundary_backtrace_restores,
+            call_boundary_frame_alloca_count,
+            call_boundary_frame_alloca_bytes,
+            call_boundary_interrupt_polls);
+    fclose(out);
+}
+
 static int JS_InitAtoms(JSRuntime *rt);

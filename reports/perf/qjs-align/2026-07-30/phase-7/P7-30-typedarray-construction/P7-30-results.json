{
 "line": "P7-30",
 "title": "new Uint8Array(64) 的阶段拆解：每次构造一次的进程内存压力探针",
 "date": "2026-07-30",
 "kind": "profiling-only",
 "production_code_changed": false,
 "baseline_commit": "a5bbbe52",
 "branch": "perf/qjs-align-p7-allocator",
 "pinned_qjs": "04be2460",
 "verdict": "single concentrated stage found",
 "verdict_detail": "Every construction whose ArrayBuffer backing store exceeds BufferPayload.inline_storage_capacity (32 bytes, src/core/object.zig:468) routes through JSRuntime.reportExternalAlloc (src/core/runtime.zig:2492), which unconditionally calls requestGCForProcessMemoryPressure (src/core/runtime.zig:2540). That reads /proc/self/statm and probes two cgroup limit files: 3 openat + 1 read + 1 close per construction, 5 syscalls, ~39.5k instructions and ~3.74 us. It is 91.3% of the zjs-qjs instruction gap and 94.3% of the time gap on new Uint8Array(64), and under the churn-free control it is still 85.1% / 91.3%. qjs has no counterpart. Under the default balanced GC policy every gate that consumes the two numbers is statically disabled (rss_soft_limit and rss_hard_limit are null, both cgroup ratios are 0, src/core/gc.zig:49-52), so processMemoryRequest always returns null on this configuration and the work is dead.",
 "engines": {
  "zjs": {
   "path": "zig-out/bin/zjs",
   "sha256": "79000b073813737c41f65ecc8e84c88c8f43a5456923323592fb705cb2fec6ad",
   "optimize": "ReleaseFast (hardwired in build.zig for the zjs step)",
   "note": "the identical binary is used on both sides of every A/B, so build bistability cannot enter the comparison"
  },
  "qjs": {
   "path": "/home/aneryu/quickjs/qjs",
   "sha256": "b76d154265e829e64d14dafba9e8f3eb8f2215ac947ffb62cc31379d1171364d",
   "commit": "04be2460",
   "build": "-O2 -DNDEBUG, no ASAN, slab active"
  }
 },
 "instruments": {
  "probe_block": {
   "path": "tools/perf/typedarray/probe_block.c",
   "what": "LD_PRELOAD interposer on openat and openat64 that counts and optionally suppresses the three probe paths",
   "why_faithful": "on this host the two cgroup files do not exist and every gate consuming rss/cgroup is disabled, so suppressing the probe reaches the same decision (no GC request) the unmodified engine reaches",
   "trap": "zjs links glibc openat64, not openat; interposing only openat counts nothing, which is how the first attempt silently read zero"
  },
  "alloc_counter": {
   "path": "tools/perf/typedarray/alloc_counter.c",
   "what": "LD_PRELOAD malloc/calloc/realloc/free counts and byte totals plus libc memset traffic",
   "caveat": "only memset calls that reach libc are visible; zjs compiles its zero fill inline and therefore reads 0 at every size, which is an instrument limit, not an absent fill"
  },
  "arena_counter": {
   "path": "tools/perf/allocator/arena_counter.c",
   "reused_from": "P7-00"
  },
  "perf": {
   "driver": "tools/perf/typedarray/run_perf.py",
   "pmu": "armv8_pmuv3_1 named explicitly so the armv8_pmuv3_0 <not counted> rows are never opened",
   "events": "instructions, cycles, raw 0x40 L1D_CACHE_RD, raw 0x41 L1D_CACHE_WR, task-clock",
   "l1d_note": "L1-dcache-stores is <not supported> on this part and L1-dcache-loads aliases the combined l1d_cache counter; the raw 0x40+0x41 pair was checked to sum to it",
   "sampling": "ABBA-balanced, even sample counts only, taskset -c 19, exclusive host lock, median"
  }
 },
 "mechanism": {
  "call_chain": [
   "ArrayBuffer backing store > 32 bytes",
   "Object.installByteStorage (src/core/object.zig:4432)",
   "JSRuntime.reportExternalAlloc (src/core/runtime.zig:2492)",
   "JSRuntime.requestGCForProcessMemoryPressure (src/core/runtime.zig:2540)",
   "currentRssBytes -> readLinuxFile(\"/proc/self/statm\") (src/core/runtime.zig:2565)",
   "cgroupLimitBytes -> readLinuxFile(\"/sys/fs/cgroup/memory.max\") then \".../memory/memory.limit_in_bytes\" (src/core/runtime.zig:2575)"
  ],
  "inline_storage_boundary_bytes": 32,
  "inline_storage_source": "src/core/object.zig:468 BufferPayload.inline_storage_capacity",
  "inline_path_is_probe_free": "installInlineByteStorage uses reportExternalAllocUntracked, which does not probe (src/core/object.zig:4448)",
  "syscalls_per_fire": {

## build commands (cold cache, independent global+local cache dirs)
```sh
set -e
cd /home/aneryu/worktrees/zjs-p7-measurement-contract
export TMPDIR="$PWD/.tmp"
export ZIG_GLOBAL_CACHE_DIR="$PWD/.build-a/zig-global-cache"
export ZJS_REPO_ROOT="$PWD"
rm -rf .build-a
mkdir -p .build-a/zig-global-cache
zig build zjs -Doptimize=ReleaseFast \
  --cache-dir "$PWD/.build-a/zig-local-cache" \
  --global-cache-dir "$PWD/.build-a/zig-global-cache" \
  --prefix "$PWD/.build-a/out" 2>&1 | tail -20
sha256sum "$PWD/.build-a/out/bin/zjs"
```
```sh
set -e
cd /home/aneryu/worktrees/zjs-p7-measurement-contract
export TMPDIR="$PWD/.tmp"
export ZJS_REPO_ROOT="$PWD"
rm -rf .build-b
mkdir -p .build-b/zig-global-cache
export ZIG_GLOBAL_CACHE_DIR="$PWD/.build-b/zig-global-cache"
zig build zjs -Doptimize=ReleaseFast \
  --cache-dir "$PWD/.build-b/zig-local-cache" \
  --global-cache-dir "$PWD/.build-b/zig-global-cache" \
  --prefix "$PWD/.build-b/out" 2>&1 | tail -20
sha256sum "$PWD/.build-b/out/bin/zjs"
```


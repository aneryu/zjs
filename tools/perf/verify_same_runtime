#!/usr/bin/env python3

"""Fail-closed policy verifier for same-runtime performance artifacts."""

from __future__ import annotations

import argparse
import json
import math
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable


SCRIPT_DIR = Path(__file__).resolve().parent
POLICY_PATH = SCRIPT_DIR / "same_runtime" / "policy.json"

CHECK_DEFINITIONS = (
    ("require-policy-declaration", "require_policy_declaration"),
    ("require-complete", "require_complete"),
    ("require-canonical-provenance", "require_canonical_provenance"),
    ("require-output-match", "require_output_match"),
    ("require-exit-line", "require_exit_line"),
)

MISSING = object()


class CliError(Exception):
    """Raised for command-line usage errors."""


class ArtifactError(Exception):
    """Raised when an artifact cannot be structurally parsed."""


class PolicyError(Exception):
    """Raised when the checked-in policy cannot be loaded."""


@dataclass(frozen=True)
class SameRuntimePolicy:
    policy_id: str
    policy_version: int
    sentinel_names: tuple[str, ...]
    geomean_limit: float
    per_case_limit: float


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise CliError(message)


def build_parser() -> ArgumentParser:
    parser = ArgumentParser(
        prog="verify_same_runtime",
        description=(
            "Read a same-runtime JSON artifact and optionally enforce "
            "phase-close policy checks."
        ),
        allow_abbrev=False,
    )
    parser.add_argument(
        "--require-policy-declaration",
        action="store_true",
        help=(
            "require the artifact to declare the checked-in policy identity "
            "and version"
        ),
    )
    parser.add_argument(
        "--require-complete",
        action="store_true",
        help="require a complete aggregate containing all policy P0 sentinels",
    )
    parser.add_argument(
        "--require-canonical-provenance",
        action="store_true",
        help="require canonical, non-overridden aggregate participants",
    )
    parser.add_argument(
        "--require-output-match",
        action="store_true",
        help="require successful cases and explicit cross-engine output agreement",
    )
    parser.add_argument(
        "--require-exit-line",
        action="store_true",
        help="require both aggregate geomean and per-case exit lines to pass",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="write one machine-readable JSON verdict to stdout",
    )
    parser.add_argument("artifact", help="same-runtime JSON artifact to verify")
    return parser


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ArtifactError(f"duplicate JSON field: {key}")
        result[key] = value
    return result


def reject_non_json_number(value: str) -> None:
    raise ArtifactError(f"invalid JSON number: {value}")


def load_artifact(path: Path) -> dict[str, Any]:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise ArtifactError(f"cannot read artifact: {error}") from error

    try:
        artifact = json.loads(
            text,
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_non_json_number,
        )
    except ArtifactError:
        raise
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ArtifactError(f"invalid JSON: {error}") from error

    if not isinstance(artifact, dict):
        raise ArtifactError("artifact root must be a JSON object")
    return artifact


def require_exact_policy_keys(
    value: Any, expected: set[str], label: str
) -> None:
    if not isinstance(value, dict):
        raise PolicyError(f"{label} must be a JSON object")
    actual = set(value)
    missing = sorted(expected - actual)
    unexpected = sorted(actual - expected)
    if missing:
        raise PolicyError(
            f"{label} is missing field(s): {', '.join(missing)}"
        )
    if unexpected:
        raise PolicyError(
            f"{label} has unexpected field(s): {', '.join(unexpected)}"
        )


def load_policy(path: Path) -> SameRuntimePolicy:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as error:
        raise PolicyError(f"cannot read policy: {error}") from error

    try:
        policy = json.loads(
            text,
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_non_json_number,
        )
    except ArtifactError as error:
        raise PolicyError(str(error)) from error
    except (UnicodeError, json.JSONDecodeError) as error:
        raise PolicyError(f"invalid JSON: {error}") from error

    require_exact_policy_keys(
        policy,
        {"policy_id", "policy_version", "sentinels", "exit_line"},
        "policy",
    )
    policy_id = policy["policy_id"]
    if not isinstance(policy_id, str) or not policy_id.strip():
        raise PolicyError("policy.policy_id must be a non-empty string")
    policy_version = policy["policy_version"]
    if (
        not isinstance(policy_version, (int, float))
        or isinstance(policy_version, bool)
        or not math.isfinite(policy_version)
        or not float(policy_version).is_integer()
        or policy_version < 1
    ):
        raise PolicyError("policy.policy_version must be a positive integer")
    policy_version = int(policy_version)

    sentinels = policy["sentinels"]
    if not isinstance(sentinels, list) or not sentinels:
        raise PolicyError("policy.sentinels must be a non-empty array")
    sentinel_names: list[str] = []
    for index, sentinel in enumerate(sentinels):
        label = f"policy.sentinels[{index}]"
        require_exact_policy_keys(
            sentinel,
            {"name", "checksum_required", "case_shape", "provenance"},
            label,
        )
        name = sentinel["name"]
        if (
            not isinstance(name, str)
            or not name
            or any(
                not (
                    character.isascii()
                    and (
                        character.isalnum()
                        or character in "_.-"
                    )
                )
                for character in name
            )
        ):
            raise PolicyError(f"{label}.name must be a valid case name")
        if name in sentinel_names:
            raise PolicyError(f"duplicate sentinel name: {name}")
        sentinel_names.append(name)
        if not isinstance(sentinel["checksum_required"], bool):
            raise PolicyError(
                f"{label}.checksum_required must be a boolean"
            )
        for field in ("case_shape", "provenance"):
            value = sentinel[field]
            if not isinstance(value, str) or not value.strip():
                raise PolicyError(
                    f"{label}.{field} must be a non-empty string"
                )

    exit_line = policy["exit_line"]
    require_exact_policy_keys(
        exit_line,
        {"geomean_limit", "per_case_limit"},
        "policy.exit_line",
    )
    limits: dict[str, float] = {}
    for field in ("geomean_limit", "per_case_limit"):
        value = exit_line[field]
        if (
            not isinstance(value, (int, float))
            or isinstance(value, bool)
            or not math.isfinite(value)
            or value <= 0
        ):
            raise PolicyError(
                f"policy.exit_line.{field} must be a positive finite number"
            )
        limits[field] = float(value)

    return SameRuntimePolicy(
        policy_id=policy_id,
        policy_version=policy_version,
        sentinel_names=tuple(sentinel_names),
        geomean_limit=limits["geomean_limit"],
        per_case_limit=limits["per_case_limit"],
    )


def field_name(path: tuple[str | int, ...]) -> str:
    output = ""
    for component in path:
        if isinstance(component, int):
            output += f"[{component}]"
        else:
            output += ("." if output else "") + component
    return output


def lookup(root: Any, path: tuple[str | int, ...]) -> Any:
    value = root
    for component in path:
        if isinstance(component, int):
            if not isinstance(value, list) or component >= len(value):
                return MISSING
            value = value[component]
        else:
            if not isinstance(value, dict) or component not in value:
                return MISSING
            value = value[component]
    return value


def json_type_name(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "boolean"
    if isinstance(value, dict):
        return "object"
    if isinstance(value, list):
        return "array"
    if isinstance(value, str):
        return "string"
    if isinstance(value, (int, float)):
        return "number"
    return type(value).__name__


def add_failure(failures: list[str], message: str) -> None:
    if message not in failures:
        failures.append(message)


def require_field(
    root: Any,
    path: tuple[str | int, ...],
    failures: list[str],
    predicate: Callable[[Any], bool],
    expected: str,
) -> Any:
    value = lookup(root, path)
    name = field_name(path)
    if value is MISSING:
        add_failure(failures, f"missing field: {name}")
        return MISSING
    if not predicate(value):
        add_failure(
            failures,
            f"invalid field: {name} (expected {expected}, got {json_type_name(value)})",
        )
        return MISSING
    return value


def is_object(value: Any) -> bool:
    return isinstance(value, dict)


def is_array(value: Any) -> bool:
    return isinstance(value, list)


def is_string(value: Any) -> bool:
    return isinstance(value, str)


def is_boolean(value: Any) -> bool:
    return isinstance(value, bool)


def is_number(value: Any) -> bool:
    return (
        isinstance(value, (int, float))
        and not isinstance(value, bool)
        and math.isfinite(value)
    )


def is_positive_number(value: Any) -> bool:
    return is_number(value) and value > 0


def case_entries(
    artifact: dict[str, Any], failures: list[str]
) -> list[tuple[int, dict[str, Any]]]:
    cases = require_field(artifact, ("cases",), failures, is_array, "array")
    if cases is MISSING:
        return []

    entries: list[tuple[int, dict[str, Any]]] = []
    for index, case in enumerate(cases):
        if not isinstance(case, dict):
            add_failure(
                failures,
                f"invalid field: cases[{index}] "
                f"(expected object, got {json_type_name(case)})",
            )
            continue
        entries.append((index, case))
    return entries


def named_cases(
    artifact: dict[str, Any], failures: list[str]
) -> tuple[list[tuple[int, dict[str, Any], str]], dict[str, tuple[int, dict[str, Any]]]]:
    named: list[tuple[int, dict[str, Any], str]] = []
    by_name: dict[str, tuple[int, dict[str, Any]]] = {}
    for index, case in case_entries(artifact, failures):
        name = require_field(
            artifact,
            ("cases", index, "name"),
            failures,
            is_string,
            "string",
        )
        if name is MISSING:
            continue
        if name in by_name:
            add_failure(failures, f"duplicate cases[].name: {name}")
            continue
        named.append((index, case, name))
        by_name[name] = (index, case)
    return named, by_name


def participant_names(
    artifact: dict[str, Any],
    failures: list[str],
    by_name: dict[str, tuple[int, dict[str, Any]]],
    policy: SameRuntimePolicy,
) -> tuple[list[str], str]:
    aggregate = require_field(
        artifact, ("aggregate",), failures, is_object, "object"
    )
    if aggregate is MISSING:
        return [], "unavailable"

    participants = lookup(artifact, ("aggregate", "participants"))
    if participants is MISSING:
        fallback = [
            name for name in policy.sentinel_names if name in by_name
        ]
        return fallback, "cases coverage fallback"
    if not isinstance(participants, list):
        add_failure(
            failures,
            "invalid field: aggregate.participants "
            f"(expected array, got {json_type_name(participants)})",
        )
        return [], "invalid aggregate.participants"

    names: list[str] = []
    for index, participant in enumerate(participants):
        path = ("aggregate", "participants", index)
        if isinstance(participant, str):
            name = participant
        elif isinstance(participant, dict):
            name = require_field(
                artifact,
                path + ("name",),
                failures,
                is_string,
                "string",
            )
            if name is MISSING:
                continue
        else:
            add_failure(
                failures,
                f"invalid field: {field_name(path)} "
                "(expected string or object with name, "
                f"got {json_type_name(participant)})",
            )
            continue
        if name in names:
            add_failure(
                failures, f"duplicate aggregate participant: {name}"
            )
            continue
        names.append(name)
        if name not in by_name:
            add_failure(
                failures,
                f"aggregate participant has no matching case: {name}",
            )
    return names, "aggregate.participants"


def result(
    name: str, failures: list[str], details: list[str]
) -> dict[str, Any]:
    return {
        "name": name,
        "passed": len(failures) == 0,
        "failures": failures,
        "details": details,
    }


def check_policy_declaration(
    artifact: dict[str, Any], policy: SameRuntimePolicy
) -> dict[str, Any]:
    failures: list[str] = []
    details = [
        "loaded checked-in policy "
        f"{policy.policy_id}@{policy.policy_version}"
    ]
    declaration = lookup(artifact, ("policy",))
    if declaration is MISSING:
        add_failure(failures, "artifact has no policy declaration")
        details.append(
            "policy declaration: absent; using explicit legacy compatibility "
            "path (use --require-policy-declaration to reject)"
        )
        return result("require-policy-declaration", failures, details)
    if not isinstance(declaration, dict):
        add_failure(
            failures,
            "invalid field: policy "
            f"(expected object, got {json_type_name(declaration)})",
        )
        return result("require-policy-declaration", failures, details)

    unsupported = sorted(
        set(declaration) - {"policy_id", "policy_version"}
    )
    if unsupported:
        add_failure(
            failures,
            "artifact policy declaration has unsupported field(s): "
            f"{', '.join(unsupported)}; policy definitions are ignored",
        )

    policy_id = require_field(
        artifact,
        ("policy", "policy_id"),
        failures,
        is_string,
        "string",
    )
    policy_version = require_field(
        artifact,
        ("policy", "policy_version"),
        failures,
        lambda value: (
            isinstance(value, int)
            and not isinstance(value, bool)
            and value >= 1
        ),
        "positive integer",
    )
    if policy_id is not MISSING and policy_id != policy.policy_id:
        add_failure(
            failures,
            "artifact policy_id "
            f"{policy_id!r} does not match checked-in policy_id "
            f"{policy.policy_id!r}",
        )
    if (
        policy_version is not MISSING
        and policy_version != policy.policy_version
    ):
        add_failure(
            failures,
            "artifact policy_version "
            f"{policy_version} does not match checked-in policy_version "
            f"{policy.policy_version}",
        )
    if not failures:
        details.append(
            "artifact policy declaration matches checked-in identity/version"
        )
    return result("require-policy-declaration", failures, details)


def check_complete(
    artifact: dict[str, Any], policy: SameRuntimePolicy
) -> dict[str, Any]:
    failures: list[str] = []
    details: list[str] = []

    complete = require_field(
        artifact,
        ("aggregate", "complete"),
        failures,
        is_boolean,
        "boolean",
    )
    if complete is not MISSING and complete is not True:
        add_failure(
            failures, "aggregate.complete is not true (got false)"
        )

    missing_cases = require_field(
        artifact,
        ("aggregate", "missing_cases"),
        failures,
        is_array,
        "array",
    )
    if missing_cases is not MISSING:
        malformed = [
            index
            for index, name in enumerate(missing_cases)
            if not isinstance(name, str)
        ]
        for index in malformed:
            add_failure(
                failures,
                f"invalid field: aggregate.missing_cases[{index}] "
                f"(expected string, got {json_type_name(missing_cases[index])})",
            )
        if missing_cases:
            rendered = ", ".join(str(name) for name in missing_cases)
            add_failure(
                failures,
                f"aggregate.missing_cases is not empty: {rendered}",
            )

    _named, by_name = named_cases(artifact, failures)
    missing_from_cases = [
        name for name in policy.sentinel_names if name not in by_name
    ]
    for name in missing_from_cases:
        add_failure(failures, f"missing P0 sentinel in cases: {name}")

    participants = lookup(artifact, ("aggregate", "participants"))
    if participants is not MISSING:
        participant_list, source = participant_names(
            artifact, failures, by_name, policy
        )
        for name in policy.sentinel_names:
            if name not in participant_list:
                add_failure(
                    failures,
                    f"missing P0 sentinel in aggregate.participants: {name}",
                )
    else:
        participant_list = [
            name for name in policy.sentinel_names if name in by_name
        ]
        source = "cases coverage fallback"

    details.append(
        f"P0 sentinels in cases: "
        f"{len(policy.sentinel_names) - len(missing_from_cases)}/"
        f"{len(policy.sentinel_names)}"
    )
    details.append(
        f"aggregate participants: {len(participant_list)}/"
        f"{len(policy.sentinel_names)} via {source}"
    )
    if isinstance(missing_cases, list):
        details.append(f"aggregate.missing_cases: {len(missing_cases)}")
    return result("require-complete", failures, details)


def canonical_source_path(name: str, value: str) -> bool:
    components: list[str] = []
    for component in value.replace("\\", "/").split("/"):
        if component in {"", "."}:
            continue
        if component == "..":
            if components:
                components.pop()
            continue
        components.append(component)
    normalized = "/".join(components)
    expected = f"tools/perf/same_runtime/cases/{name}.js"
    return normalized == expected or normalized.endswith(f"/{expected}")


def check_canonical_provenance(
    artifact: dict[str, Any],
    policy: SameRuntimePolicy,
) -> dict[str, Any]:
    failures: list[str] = []
    details: list[str] = []

    _named, by_name = named_cases(artifact, failures)
    participants, source = participant_names(
        artifact, failures, by_name, policy
    )
    if not participants:
        add_failure(
            failures,
            "no aggregate participants available to prove canonical provenance",
        )

    case_sources = require_field(
        artifact,
        ("case_sources",),
        failures,
        is_object,
        "object",
    )

    for name in participants:
        entry = by_name.get(name)
        if entry is None:
            continue
        index, _case = entry
        canonical = require_field(
            artifact,
            ("cases", index, "canonical_source"),
            failures,
            is_boolean,
            "boolean",
        )
        if canonical is not MISSING and canonical is not True:
            add_failure(
                failures,
                f"case {name} canonical_source is not true",
            )

        shape = require_field(
            artifact,
            ("cases", index, "case_shape"),
            failures,
            is_string,
            "string",
        )
        if shape in {"overridden", "custom"}:
            add_failure(
                failures,
                f"case {name} has non-canonical case_shape: {shape}",
            )

        comparability = lookup(
            artifact, ("cases", index, "comparability")
        )
        if comparability is not MISSING:
            if not isinstance(comparability, dict):
                add_failure(
                    failures,
                    f"invalid field: cases[{index}].comparability "
                    f"(expected object, got {json_type_name(comparability)})",
                )
            else:
                provenance = lookup(
                    artifact,
                    ("cases", index, "comparability", "provenance"),
                )
                if provenance is not MISSING:
                    if not isinstance(provenance, dict):
                        add_failure(
                            failures,
                            f"invalid field: cases[{index}]."
                            "comparability.provenance "
                            "(expected object, got "
                            f"{json_type_name(provenance)})",
                        )
                    else:
                        comparable = require_field(
                            artifact,
                            (
                                "cases",
                                index,
                                "comparability",
                                "provenance",
                                "comparable",
                            ),
                            failures,
                            is_boolean,
                            "boolean",
                        )
                        if (
                            comparable is not MISSING
                            and comparable is not True
                        ):
                            add_failure(
                                failures,
                                f"case {name} provenance comparability "
                                "is not true",
                            )

        if isinstance(case_sources, dict):
            source_path = case_sources.get(name, MISSING)
            if source_path is MISSING:
                add_failure(
                    failures, f"missing field: case_sources.{name}"
                )
            elif not isinstance(source_path, str):
                add_failure(
                    failures,
                    f"invalid field: case_sources.{name} "
                    f"(expected string, got {json_type_name(source_path)})",
                )
            elif not canonical_source_path(name, source_path):
                add_failure(
                    failures,
                    f"case_sources.{name} overrides canonical source: "
                    f"{source_path}",
                )

    # Even a non-participating sentinel must not carry an override that could
    # later be mistaken for canonical provenance.
    if isinstance(case_sources, dict):
        for name in policy.sentinel_names:
            source_path = case_sources.get(name, MISSING)
            if source_path is MISSING:
                continue
            if not isinstance(source_path, str):
                add_failure(
                    failures,
                    f"invalid field: case_sources.{name} "
                    f"(expected string, got {json_type_name(source_path)})",
                )
            elif not canonical_source_path(name, source_path):
                add_failure(
                    failures,
                    f"case_sources.{name} overrides canonical source: "
                    f"{source_path}",
                )

    details.append(
        f"aggregate participants checked: {len(participants)} via {source}"
    )
    details.append("forbidden case shapes: overridden, custom")
    return result("require-canonical-provenance", failures, details)


def check_output_match(artifact: dict[str, Any]) -> dict[str, Any]:
    failures: list[str] = []
    details: list[str] = []
    named, _by_name = named_cases(artifact, failures)
    if not named:
        add_failure(
            failures, "no cases available to prove output agreement"
        )

    exempt_cases: list[str] = []
    for index, _case, name in named:
        status = require_field(
            artifact,
            ("cases", index, "status"),
            failures,
            is_string,
            "string",
        )
        if status is not MISSING and status != "ok":
            add_failure(
                failures,
                f"case {name} status is {status!r}, expected 'ok'",
            )

        checksum_required = require_field(
            artifact,
            ("cases", index, "checksum_required"),
            failures,
            is_boolean,
            "boolean",
        )
        declared = require_field(
            artifact,
            ("cases", index, "checksum_requirement_declared"),
            failures,
            is_boolean,
            "boolean",
        )
        if checksum_required is MISSING:
            continue
        if checksum_required is False:
            if declared is not True:
                add_failure(
                    failures,
                    f"case {name} checksum_required=false is not "
                    "explicitly declared",
                )
            else:
                exempt_cases.append(name)
            continue

        checksum = require_field(
            artifact,
            ("cases", index, "comparability", "checksum"),
            failures,
            is_object,
            "object",
        )
        if checksum is MISSING:
            continue
        comparable = require_field(
            artifact,
            (
                "cases",
                index,
                "comparability",
                "checksum",
                "comparable",
            ),
            failures,
            is_boolean,
            "boolean",
        )
        if comparable is not MISSING and comparable is not True:
            add_failure(
                failures,
                f"case {name} checksum comparability is not true",
            )
        all_match = require_field(
            artifact,
            (
                "cases",
                index,
                "comparability",
                "checksum",
                "all_invocations_match",
            ),
            failures,
            is_boolean,
            "boolean",
        )
        if all_match is not MISSING and all_match is not True:
            add_failure(
                failures,
                f"case {name} checksums do not match across all invocations",
            )

    for field in ("mismatch", "invalid"):
        count = require_field(
            artifact,
            ("status_counts", field),
            failures,
            is_number,
            "number",
        )
        if count is not MISSING and count != 0:
            add_failure(
                failures,
                f"status_counts.{field} is {count}, expected 0",
            )

    details.append(f"cases checked: {len(named)}")
    details.append(
        "explicit checksum exemptions: "
        + (", ".join(exempt_cases) if exempt_cases else "none")
    )
    return result("require-output-match", failures, details)


def format_ratio(value: float) -> str:
    return f"{value:.4f}"


def format_limit(value: float) -> str:
    return f"{value:.2f}"


STEADY_RATIO_PATH = ("paired_ratios", "steady_execute_median_ns", "median")


def recompute_sentinel_ratios(
    artifact: dict[str, Any],
    policy: SameRuntimePolicy,
    failures: list[str],
) -> dict[str, float] | None:
    """Recompute every sentinel ratio from cases[], ignoring aggregate.

    A gate that reads the conclusion the audited object wrote about itself is
    not a gate. Without this, an artifact whose cases[] still hold the real
    (failing) ratios passes simply by rewriting aggregate.p0_sentinel_geomean
    and clearing over_limit_cases -- the policy identity and the limits can all
    stay honest. Everything the exit-line check decides is derived here and the
    artifact's own numbers are only cross-checked against it.
    """
    cases = artifact.get("cases")
    if not isinstance(cases, list):
        add_failure(
            failures, "cannot recompute exit line: cases is not an array"
        )
        return None

    by_name: dict[str, dict[str, Any]] = {}
    for case in cases:
        if isinstance(case, dict) and isinstance(case.get("name"), str):
            by_name[case["name"]] = case

    ratios: dict[str, float] = {}
    for name in policy.sentinel_names:
        case = by_name.get(name)
        if case is None:
            add_failure(
                failures,
                f"cannot recompute exit line: case {name} is absent "
                "from cases",
            )
            return None
        node: Any = case
        for key in STEADY_RATIO_PATH:
            node = node.get(key) if isinstance(node, dict) else None
        if not is_positive_number(node):
            add_failure(
                failures,
                f"cannot recompute exit line: case {name} has no positive "
                "paired_ratios.steady_execute_median_ns.median",
            )
            return None
        ratios[name] = float(node)
    return ratios


def check_exit_line(
    artifact: dict[str, Any], policy: SameRuntimePolicy
) -> dict[str, Any]:
    failures: list[str] = []
    details: list[str] = []

    exit_line = require_field(
        artifact,
        ("aggregate", "exit_line"),
        failures,
        is_object,
        "object",
    )
    if exit_line is MISSING:
        return result("require-exit-line", failures, details)

    geomean = require_field(
        artifact,
        ("aggregate", "p0_sentinel_geomean"),
        failures,
        is_positive_number,
        "positive finite number",
    )
    geomean_limit = require_field(
        artifact,
        ("aggregate", "exit_line", "geomean_limit"),
        failures,
        is_positive_number,
        "positive finite number",
    )
    geomean_pass = require_field(
        artifact,
        ("aggregate", "exit_line", "geomean_pass"),
        failures,
        is_boolean,
        "boolean",
    )

    if (
        geomean_limit is not MISSING
        and geomean_limit != policy.geomean_limit
    ):
        add_failure(
            failures,
            "aggregate.exit_line.geomean_limit is "
            f"{format_limit(geomean_limit)}, expected policy limit "
            f"{format_limit(policy.geomean_limit)}",
        )

    if geomean is not MISSING:
        details.append(
            f"geomean {format_ratio(geomean)} "
            f"(policy limit {format_limit(policy.geomean_limit)})"
        )
        if geomean > policy.geomean_limit:
            add_failure(
                failures,
                f"geomean {format_ratio(geomean)} > "
                f"limit {format_limit(policy.geomean_limit)}",
            )
        elif geomean_pass is not MISSING and geomean_pass is not True:
            add_failure(
                failures,
                "aggregate.exit_line.geomean_pass is not true "
                f"(geomean {format_ratio(geomean)} <= "
                f"limit {format_limit(policy.geomean_limit)})",
            )
    elif geomean_pass is not MISSING and geomean_pass is not True:
        add_failure(
            failures, "aggregate.exit_line.geomean_pass is not true"
        )

    per_case_limit = require_field(
        artifact,
        ("aggregate", "exit_line", "per_case_limit"),
        failures,
        is_positive_number,
        "positive finite number",
    )
    per_case_pass = require_field(
        artifact,
        ("aggregate", "exit_line", "per_case_pass"),
        failures,
        is_boolean,
        "boolean",
    )
    over_limit = require_field(
        artifact,
        ("aggregate", "exit_line", "over_limit_cases"),
        failures,
        is_array,
        "array",
    )

    rendered_over_limit: list[str] = []
    if (
        per_case_limit is not MISSING
        and per_case_limit != policy.per_case_limit
    ):
        add_failure(
            failures,
            "aggregate.exit_line.per_case_limit is "
            f"{format_limit(per_case_limit)}, expected policy limit "
            f"{format_limit(policy.per_case_limit)}",
        )
    if isinstance(over_limit, list):
        for index, item in enumerate(over_limit):
            if not isinstance(item, dict):
                add_failure(
                    failures,
                    f"invalid field: aggregate.exit_line."
                    f"over_limit_cases[{index}] "
                    f"(expected object, got {json_type_name(item)})",
                )
                continue
            name = require_field(
                artifact,
                (
                    "aggregate",
                    "exit_line",
                    "over_limit_cases",
                    index,
                    "name",
                ),
                failures,
                is_string,
                "string",
            )
            ratio = require_field(
                artifact,
                (
                    "aggregate",
                    "exit_line",
                    "over_limit_cases",
                    index,
                    "ratio",
                ),
                failures,
                is_positive_number,
                "positive finite number",
            )
            if (
                name is not MISSING
                and ratio is not MISSING
            ):
                message = (
                    f"{name} {format_ratio(ratio)} > "
                    f"{format_limit(policy.per_case_limit)}"
                )
                rendered_over_limit.append(message)
                if ratio > policy.per_case_limit:
                    add_failure(failures, message)
                else:
                    add_failure(
                        failures,
                        "invalid over_limit_cases entry: "
                        f"{name} ratio {format_ratio(ratio)} <= "
                        f"limit {format_limit(policy.per_case_limit)}",
                    )

    if per_case_pass is not MISSING and per_case_pass is not True:
        if not rendered_over_limit:
            add_failure(
                failures,
                "aggregate.exit_line.per_case_pass is not true",
            )
    elif per_case_pass is True and rendered_over_limit:
        add_failure(
            failures,
            "aggregate.exit_line.per_case_pass is true but "
            "over_limit_cases is not empty",
        )

    if per_case_limit is not MISSING:
        details.append(
            f"per-case policy limit {format_limit(policy.per_case_limit)}; "
            f"over-limit cases: "
            f"{len(over_limit) if isinstance(over_limit, list) else 'unknown'}"
        )

    # Everything above validated the artifact's own conclusions against the
    # policy. That is not sufficient on its own: an artifact can keep honest
    # limits and an honest policy identity while simply writing a passing
    # geomean over cases[] that still hold failing ratios. Re-derive the exit
    # line from cases[] and let the recomputed values decide.
    recomputed = recompute_sentinel_ratios(artifact, policy, failures)
    if recomputed is None:
        return result("require-exit-line", failures, details)

    recomputed_geomean = math.exp(
        sum(math.log(value) for value in recomputed.values())
        / len(recomputed)
    )
    recomputed_over = sorted(
        name
        for name, value in recomputed.items()
        if value > policy.per_case_limit
    )
    details.append(
        f"recomputed from cases: geomean "
        f"{format_ratio(recomputed_geomean)}, over-limit "
        f"{len(recomputed_over)}"
    )

    if geomean is not MISSING and not math.isclose(
        geomean, recomputed_geomean, rel_tol=1e-9, abs_tol=0.0
    ):
        add_failure(
            failures,
            f"aggregate.p0_sentinel_geomean is {format_ratio(geomean)} but "
            f"cases recompute to {format_ratio(recomputed_geomean)}",
        )
    declared_over = sorted(
        item["name"]
        for item in (over_limit if isinstance(over_limit, list) else [])
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    )
    if declared_over != recomputed_over:
        add_failure(
            failures,
            "aggregate.exit_line.over_limit_cases names are "
            f"{declared_over or 'empty'} but cases recompute to "
            f"{recomputed_over or 'empty'}",
        )

    if recomputed_geomean > policy.geomean_limit:
        add_failure(
            failures,
            f"recomputed geomean {format_ratio(recomputed_geomean)} > "
            f"limit {format_limit(policy.geomean_limit)}",
        )
    for name in recomputed_over:
        add_failure(
            failures,
            f"recomputed {name} {format_ratio(recomputed[name])} > "
            f"limit {format_limit(policy.per_case_limit)}",
        )
    return result("require-exit-line", failures, details)


def evaluate(
    artifact: dict[str, Any],
    args: argparse.Namespace,
    policy: SameRuntimePolicy,
) -> dict[str, Any]:
    checks = [
        check_policy_declaration(artifact, policy),
        check_complete(artifact, policy),
        check_canonical_provenance(artifact, policy),
        check_output_match(artifact),
        check_exit_line(artifact, policy),
    ]
    requested_by_name = {
        name: bool(getattr(args, destination))
        for name, destination in CHECK_DEFINITIONS
    }
    for check in checks:
        check["requested"] = requested_by_name[check["name"]]

    passed = all(
        check["passed"] for check in checks if check["requested"]
    )
    exit_code = 0 if passed else 1
    return {
        "artifact": args.artifact,
        "loaded_policy": {
            "policy_id": policy.policy_id,
            "policy_version": policy.policy_version,
        },
        "checks": checks,
        "passed": passed,
        "exit_code": exit_code,
    }


def print_human(verdict: dict[str, Any]) -> None:
    print(f"Artifact: {verdict['artifact']}")
    requested_count = sum(
        1 for check in verdict["checks"] if check["requested"]
    )
    if requested_count == 0:
        print("Policy mode: advisory (no --require-* options requested)")

    for check in verdict["checks"]:
        status = "PASS" if check["passed"] else "FAIL"
        qualifier = "required" if check["requested"] else "not requested"
        print(f"{status} {check['name']} [{qualifier}]")
        for detail in check["details"]:
            print(f"  {detail}")
        for failure in check["failures"]:
            print(f"  - {failure}")

    if requested_count == 0:
        print("Overall: PASS (artifact parsed; policy checks not enforced)")
    else:
        status = "PASS" if verdict["passed"] else "FAIL"
        print(f"Overall: {status} (exit {verdict['exit_code']})")


def error_verdict(
    artifact: str | None, message: str, exit_code: int = 2
) -> dict[str, Any]:
    return {
        "artifact": artifact,
        "checks": [],
        "passed": False,
        "exit_code": exit_code,
        "error": message,
    }


def emit_error(
    artifact: str | None, message: str, json_mode: bool
) -> int:
    verdict = error_verdict(artifact, message)
    if json_mode:
        print(json.dumps(verdict, separators=(",", ":")))
    else:
        print(f"error: {message}", file=sys.stderr)
    return verdict["exit_code"]


def main(argv: list[str] | None = None) -> int:
    raw_args = sys.argv[1:] if argv is None else argv
    json_mode = "--json" in raw_args
    parser = build_parser()
    try:
        args = parser.parse_args(raw_args)
    except CliError as error:
        return emit_error(None, str(error), json_mode)

    try:
        policy = load_policy(POLICY_PATH)
    except PolicyError as error:
        return emit_error(
            args.artifact,
            f"cannot load checked-in policy {POLICY_PATH}: {error}",
            args.json,
        )

    try:
        artifact = load_artifact(Path(args.artifact))
    except ArtifactError as error:
        return emit_error(args.artifact, str(error), args.json)

    verdict = evaluate(artifact, args, policy)
    if args.json:
        print(json.dumps(verdict, separators=(",", ":")))
    else:
        print_human(verdict)
    return int(verdict["exit_code"])


if __name__ == "__main__":
    raise SystemExit(main())
